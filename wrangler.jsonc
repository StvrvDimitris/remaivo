{
  // A fresh Remaivo on Cloudflare, used by the Deploy to Cloudflare button and
  // for local development. Cloudflare creates the D1 database on first deploy.
  // Set the REMAIVO_PASSWORD secret before signing in (see cloudflare/README.md).
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remaivo",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "FINANCE_RATE_LIMIT", "namespace_id": "1003", "simple": { "limit": 120, "period": 60 } },
    { "name": "PAGE_RATE_LIMIT", "namespace_id": "1004", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": { "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "remaivo",
    "migrations_dir": "cloudflare/migrations"
  }],
  "vars": {
    "REMAIVO_PLATFORM": "cloudflare"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
