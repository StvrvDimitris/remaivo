{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remaivo",
  "account_id": "e1d766e42c9230769cb020c485f7dc2c",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "ratelimits": [
    { "name": "LOGIN_RATE_LIMIT", "namespace_id": "472601", "simple": { "limit": 10, "period": 60 } },
    { "name": "FINANCE_RATE_LIMIT", "namespace_id": "472603", "simple": { "limit": 120, "period": 60 } },
    { "name": "PAGE_RATE_LIMIT", "namespace_id": "472604", "simple": { "limit": 60, "period": 60 } }
  ],
  "assets": { "binding": "ASSETS", "not_found_handling": "none" },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "remaivo-production",
    "database_id": "0ed8f911-a18e-490d-9f29-d4455d4b2d63",
    "migrations_dir": "cloudflare/migrations"
  }],
  "vars": {
    "REMAIVO_PLATFORM": "cloudflare",
    "APP_ORIGIN": "https://remaivo.stayrou99.workers.dev"
  },
  "observability": { "enabled": true, "head_sampling_rate": 0.1, "traces": { "enabled": true, "head_sampling_rate": 0.1 } }
}
