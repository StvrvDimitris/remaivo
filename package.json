{
  "name": "remaivo-personal-finance",
  "version": "1.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "deploy": "vinext build && wrangler deploy",
    "test": "node --test --test-isolation=none tests/reconciliation.test.mjs tests/investment-valuations.test.mjs tests/statistics.test.mjs tests/v3-integration.test.mjs tests/schema-ensure.test.mjs tests/backup.test.mjs tests/setup.test.mjs tests/finance-page-cache.test.mjs tests/spare-change.test.mjs tests/goals.test.mjs tests/archive.test.mjs tests/finance-refresh.test.mjs tests/auth.test.mjs tests/rate-limit.test.mjs tests/ui-language.test.mjs tests/ledger.test.mjs tests/accounts-report.test.mjs",
    "test:investment": "node --test --test-isolation=none tests/investment-valuations.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern work",
    "db:generate": "drizzle-kit generate",
    "test:v3": "node --test --test-isolation=none tests/v3-integration.test.mjs",
    "test:setup": "node --test --test-isolation=none tests/setup.test.mjs"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "^5.20260819.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vinext/types": "1.0.0-beta.2",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "miniflare": "4.20260515.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
